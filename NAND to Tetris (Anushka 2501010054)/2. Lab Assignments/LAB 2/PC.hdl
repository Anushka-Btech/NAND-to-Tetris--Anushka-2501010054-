CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];
    PARTS:
    Inc16(in=out, out=incremented);
    Mux16(a=out, b=incremented, sel=inc, out=oldOrInc);
    Mux16(a=oldOrInc, b=in, sel=load, out=oldIncOrLoad);
    Mux16(a=oldIncOrLoad, b=false, sel=reset, out=next);
    Register(in=next, load=true, out=out);
}
