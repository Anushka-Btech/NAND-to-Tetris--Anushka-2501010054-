CHIP RAM8K {
    IN in[16], load, address[13];
    OUT out[16];
    PARTS:
    DMux(in=load, sel=address[12], a=loadLow, b=loadHigh);
    RAM4K(in=in, load=loadLow, address=address[0..11], out=lowOut);
    RAM4K(in=in, load=loadHigh, address=address[0..11], out=highOut);
    Mux16(a=lowOut, b=highOut, sel=address[12], out=out);
}
